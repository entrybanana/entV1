{
  "manifest_version": 3,
  "name": "entV1",
  "version": "1.0.0",
  "description": "웹사이트와 리디렉션을 검사하는 보안 확장 프로그램",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
